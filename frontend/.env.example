# ===========================================
# Web3 dApp Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -------------------------------------------
# WalletConnect (Required)
# -------------------------------------------
# Get your project ID at https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# -------------------------------------------
# Privy (Optional - Recommended for best UX)
# -------------------------------------------
# Get your app ID at https://dashboard.privy.io/
# If not set, falls back to RainbowKit-only auth
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id

# -------------------------------------------
# RPC Providers (Optional - Recommended for production)
# -------------------------------------------
# Using dedicated RPC providers improves reliability and speed
# Get your API key at https://www.alchemy.com/
NEXT_PUBLIC_ALCHEMY_ID=your_alchemy_api_key

# Alternative: Infura
# NEXT_PUBLIC_INFURA_ID=your_infura_project_id

# -------------------------------------------
# Analytics (Optional)
# -------------------------------------------
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx

# -------------------------------------------
# Feature Flags (Optional)
# -------------------------------------------
# NEXT_PUBLIC_ENABLE_TESTNETS=true
